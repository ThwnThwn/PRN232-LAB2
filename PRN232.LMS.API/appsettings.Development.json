  //
  // KHÔNG commit mật khẩu thật vào file này (dùng user-secrets hoặc biến môi trường nếu cần).
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=PRN232LMS;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
