{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=PRN232LMS;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  // JWT settings.
  // NOTE: in Docker the secret is NOT read from here — it comes from the JWT_SECRET
  // environment variable (.env -> docker-compose.yml -> Jwt__Key).
  "Jwt": {
    "Key": "",
    "Issuer": "PRN232.LMS",
    "Audience": "PRN232.LMS.Client",
    "ExpirySeconds": 3600,
    "RefreshTokenDays": 7,

    // Cookie mode: true = refresh token is sent as an HttpOnly cookie (browser clients)
    // instead of being returned in the JSON body (API/mobile clients).
    "UseRefreshTokenCookie": false,
    "RefreshTokenCookieName": "prn232_refresh_token",
    "CookieSecure": false,

    // Background job: how often expired refresh tokens are deleted (minutes).
    "CleanupIntervalMinutes": 60
  }
}
